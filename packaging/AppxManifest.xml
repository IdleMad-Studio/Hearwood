<?xml version="1.0" encoding="utf-8"?>
<!--
  Hearwood's MSIX manifest. tools/build-msix.ps1 fills in the $...$ values for each package it builds:
  the identity comes from Partner Center (Product identity page) once the name is reserved.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap5 rescap">

  <Identity Name="$IdentityName$" Publisher="$Publisher$" Version="$Version$" ProcessorArchitecture="$Arch$" />

  <Properties>
    <DisplayName>Hearwood</DisplayName>
    <PublisherDisplayName>$PublisherDisplayName$</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Hearwood" Executable="Hearwood.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Hearwood"
        Description="Reads text aloud with built-in voices, on your own PC."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile Wide310x150Logo="Assets\Wide310x150Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <!-- Start with Windows. Off until the user turns it on from the tray (StartupRegistration). -->
        <uap5:Extension Category="windows.startupTask" Executable="Hearwood.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:StartupTask TaskId="HearwoodStartup" Enabled="false" DisplayName="Hearwood" />
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- A desktop (Win32) app: global hotkeys, reading the selection, its own settings files. -->
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
